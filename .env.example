# Customer Thermometer API key, from Account > Integration settings.
# Either a "Super API key" (full account access) or a narrower "sub-API key".
# Used by stdio and by HTTP when AUTH_MODE=env. The gateway Compose service
# does not load this. Do not add it to that service's environment or via env_file.
CUSTOMERTHERMOMETER_API_KEY=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# env (default): read CUSTOMERTHERMOMETER_API_KEY.
# gateway: require X-CustomerThermometer-Api-Key on each /mcp request and never
# fall back to the environment. The Docker image and Compose file default to gateway.
# AUTH_MODE=env

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# only — a non-loopback MCP_HTTP_HOST is ignored. A known placeholder secret
# still refuses to start. Do not use this in production.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when MCP_TRANSPORT=http. When unset, the server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image sets 0.0.0.0.
# Without a secret, MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# LOG_LEVEL=info
